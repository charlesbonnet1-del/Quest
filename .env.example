# ── ElevenLabs (utilisé UNIQUEMENT par `pnpm audio:generate`, jamais par l'app) ──
ELEVENLABS_API_KEY=
# Identifiants des voix (bibliothèque de voix ElevenLabs)
ELEVENLABS_VOICE_NARRATEUR=
ELEVENLABS_VOICE_HEROS=
# Modèle économique pour itérer (par défaut eleven_flash_v2_5)
ELEVENLABS_MODEL=eleven_flash_v2_5
# Modèle de qualité maximale, utilisé avec --quality (par défaut eleven_multilingual_v2 ; eleven_v3 possible)
ELEVENLABS_MODEL_QUALITY=eleven_multilingual_v2
# Format de sortie : MP3 mono ~64 kbps (mp3_22050_32 pour encore plus léger)
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64
# Langue forcée (seulement pour les modèles Flash/Turbo v2.5)
ELEVENLABS_LANGUAGE_CODE=fr
# Tarif pour l'estimation du coût (par 1000 caractères). Vide = 0,15 (Flash) / 0,30 (autres), indicatif.
ELEVENLABS_COST_PER_1K_CHARS=
ELEVENLABS_COST_CURRENCY=USD
# Requêtes simultanées (selon votre offre ElevenLabs)
ELEVENLABS_CONCURRENCY=2
# Réglages de voix optionnels (JSON), ex. {"stability":0.5,"similarity_boost":0.75,"speed":0.95}
ELEVENLABS_VOICE_SETTINGS=

# ── Stockage ──
# Jeton Vercel Blob : audio (public) et, à défaut de FEEDBACK_BLOB_READ_WRITE_TOKEN, retours.
BLOB_READ_WRITE_TOKEN=
# "blob" ou "local" (public/audio). Par défaut : blob si un jeton est présent.
AUDIO_STORAGE=
# Magasin Blob PRIVÉ conseillé pour les retours (sinon BLOB_READ_WRITE_TOKEN, et FEEDBACK_BLOB_ACCESS=public)
FEEDBACK_BLOB_READ_WRITE_TOKEN=
FEEDBACK_BLOB_ACCESS=private

# ── Overpass (OpenStreetMap) ──
# Liste séparée par des virgules, essayée dans l'ordre
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT_MS=20000

# ── Administration ──
# Secret pour lire les retours sur /admin (12 caractères minimum)
ADMIN_SECRET=
